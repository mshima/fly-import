{
  "name": "fly-import",
  "version": "2.1.0",
  "description": "Install and import packages on-the-fly",
  "keywords": [
    "npm",
    "npx",
    "import",
    "loaders",
    "on-demand"
  ],
  "homepage": "https://github.com/mshima/fly-import#readme",
  "bugs": {
    "url": "https://github.com/mshima/fly-import/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshima/fly-import.git"
  },
  "license": "MIT",
  "author": "Marcelo Shima <marceloshima@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "lint": "xo && prettier --check .",
    "prepare": "npm run build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@npmcli/arborist": "^10.0.3",
    "env-paths": "^4.0.0",
    "npm-package-arg": "^14.0.0",
    "registry-auth-token": "^5.1.0",
    "registry-url": "^7.2.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@node-loaders/esbuildx": "^2.0.0",
    "@types/node": "^26.6.3",
    "@types/npm-package-arg": "^6.1.4",
    "@types/npmcli__arborist": "^6.3.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.3",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "xo": "^5.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
